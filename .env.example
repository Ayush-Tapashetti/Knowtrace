# KnowTrace environment. Copy to .env (gitignored). Never commit real secrets.

# --- App ---
APP_ENV=development                    # development | test | production
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173     # comma-separated allowlist, no wildcard
RATE_LIMIT_PER_MINUTE=120              # per-client in-process token bucket

# --- Data ---
DATABASE_URL=sqlite:///./data/knowtrace.db   # SQLite by default; Postgres URL also works
CURRICULUM_DIR=./backend/content/seed        # authored JSON: concepts, edges, items, atoms
AUTO_RESEED=true                       # dev only: rebuild + reseed when curriculum_hash changes

# --- Domain thresholds (defaults match docs/pipeline/03-domain-schema.md) ---
THETA_MASTER=0.85                      # mastery cutoff for "mastered" and lesson inclusion
TAU_CONF=0.80                          # posterior needed to call a gap or a slip
MIN_PROBES=1
MAX_PROBES=4
MAX_RECHECKS=3
LESSON_BUDGET_SECONDS=300
MIN_CHECKS=2

# --- Determinism / optional model (D3) ---
DETERMINISTIC_ONLY=true                # true = never call a model; authored text only
LLM_REPHRASE_ENABLED=false             # model is used only if DETERMINISTIC_ONLY=false AND this is true AND a key is set
ANTHROPIC_API_KEY=                     # optional; leave empty. Never logged, never sent to the browser
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# --- Eval harness (D1, D2) ---
EVAL_SEED=1234                         # same seed + same curriculum_hash gives the same results
EVAL_N_STUDENTS=300

# --- Frontend (Vite exposes only VITE_* variables; public by design) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
